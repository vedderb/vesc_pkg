; Boosted Board CAN Protocol Implementation
;
; The protocol itself lives in the native library under boosted/: CAN
; transmit and receive, the keep-alive ping, reassembly and parsing of the
; AFE cell report, and the "data:status" / "data:cells" replies ui.qml reads.
;
; What is left here is the one thing the C interface cannot do. set-bms-val
; has no C equivalent, so this polls ext-boosted-bms for the decoded state
; and republishes it as VESC BMS values.

(import "boosted/boosted_esp32c3.bin" 'lib-esp32c3)
(import "boosted/boosted_esp32c6.bin" 'lib-esp32c6)
(import "boosted/boosted_esp32s3.bin" 'lib-esp32s3)
(import "boosted/boosted_esp32p4.bin" 'lib-esp32p4)
(import "boosted/boosted_stm32.bin" 'lib-stm32)

@const-start

(define bms-poll-interval 0.2)

; Offsets into the blob ext-boosted-bms returns. Keep in step with the layout
; comment on ext_bms in boosted/code.c.
(define bms-off-cell-count 1)
(define bms-off-pack-mv 4)
(define bms-off-current-ma 8)
(define bms-off-cell-min 12)
(define bms-off-cell-max 14)
(define bms-off-soc 16)
(define bms-off-cells 20)

; Native libs only run on the chip they were built for. On VESC Express that
; needs firmware new enough to report (sysinfo 'hw-target); everything else
; is an STM32 VESC.
(defun esp-lib (target)
  (cond
    ((= (str-cmp target "esp32c3") 0) lib-esp32c3)
    ((= (str-cmp target "esp32c6") 0) lib-esp32c6)
    ((= (str-cmp target "esp32s3") 0) lib-esp32s3)
    ((= (str-cmp target "esp32p4") 0) lib-esp32p4)
    (t nil)
  )
)

(defun select-lib () {
  (var res (trap
    (if (eq (sysinfo 'hw-type) 'hw-express)
      (esp-lib (sysinfo 'hw-target))
      lib-stm32
    )
  ))
  (if (eq (car res) 'exit-ok) (ix res 1) nil)
})

(defun bms-loop ()
  (loopwhile t {
    (sleep bms-poll-interval)

    (var b (ext-boosted-bms))
    (var n (bufget-u8 b bms-off-cell-count))

    (set-bms-val 'bms-cell-num n)
    (set-bms-val 'bms-v-tot (/ (bufget-i32 b bms-off-pack-mv 'little-endian) 1000.0))

    ; The pack reports discharge as positive current, VESC expects the
    ; opposite sign.
    (set-bms-val 'bms-i-in-ic (/ (bufget-i32 b bms-off-current-ma 'little-endian) -1000.0))

    (set-bms-val 'bms-soc (/ (bufget-u8 b bms-off-soc) 100.0))
    (set-bms-val 'bms-v-cell-min (/ (bufget-u16 b bms-off-cell-min 'little-endian) 1000.0))
    (set-bms-val 'bms-v-cell-max (/ (bufget-u16 b bms-off-cell-max 'little-endian) 1000.0))

    ; A cell still reading zero has not appeared in an AFE report yet - leave
    ; whatever VESC already holds rather than publishing it as 0 V.
    (looprange i 0 n {
      (var mv (bufget-u16 b (+ bms-off-cells (* i 2)) 'little-endian))
      (if (> mv 0) (set-bms-val 'bms-v-cell i (/ mv 1000.0)))
    })
  })
)

@const-end

; --- Main Entry ---
(print "Starting Boosted VESC Driver...")

(define lib (select-lib))

(if (eq lib nil)
  (print "Boosted Doctor: no native lib for this hardware (VESC Express needs firmware that reports (sysinfo 'hw-target))")
  {
    (load-native-lib lib)

    ; Uncomment for a per-frame decode trace in the lisp console.
    ;(ext-boosted-debug 1)

    (spawn bms-loop)
    (print "Driver Started. Waiting for Battery...")
  }
)
