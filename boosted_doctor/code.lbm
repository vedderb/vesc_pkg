; Boosted Board CAN Protocol Implementation
;
; The protocol itself lives in the native library under boosted/: CAN
; transmit and receive, the keep-alive ping, reassembly and parsing of the
; AFE cell report, and the "data:status" / "data:cells" replies ui.qml reads.

(import "boosted/boosted_esp32c3.bin" 'lib-esp32c3)
(import "boosted/boosted_esp32c6.bin" 'lib-esp32c6)
(import "boosted/boosted_esp32s3.bin" 'lib-esp32s3)
(import "boosted/boosted_esp32p4.bin" 'lib-esp32p4)
(import "boosted/boosted_stm32.bin" 'lib-stm32)

@const-start

(define bms-poll-interval 0.2)

; Offsets into the blob ext-boosted-bms returns. Keep in step with the layout
; comment on ext_bms in boosted/code.c.
(define bms-off-cell-count 1)
(define bms-off-pack-mv 4)
(define bms-off-current-ma 8)
(define bms-off-cell-min 12)
(define bms-off-cell-max 14)
(define bms-off-soc 16)
(define bms-off-cells 20)

; Matches BD_CELL_MV_NONE. A cell with no reading yet, as distinct from a cell
; genuinely reading 0 mV.
(define bms-cell-mv-none 0xFFFF)

; Native libs only run on the chip they were built for. On VESC Express that
; needs firmware new enough to report (sysinfo 'hw-target); everything else
; is an STM32 VESC.
(defun esp-lib (target)
  (cond
    ((= (str-cmp target "esp32c3") 0) lib-esp32c3)
    ((= (str-cmp target "esp32c6") 0) lib-esp32c6)
    ((= (str-cmp target "esp32s3") 0) lib-esp32s3)
    ((= (str-cmp target "esp32p4") 0) lib-esp32p4)
    (t nil)
  )
)

(defun select-lib () {
  (var res (trap
    (if (eq (sysinfo 'hw-type) 'hw-express)
      (esp-lib (sysinfo 'hw-target))
      lib-stm32
    )
  ))
  (if (eq (ix res 0) 'exit-ok) (ix res 1) nil)
})

(defun bms-loop ()
  (loopwhile t {
    (sleep bms-poll-interval)

    ; nil while the "Publish as VESC BMS" setting is off. Read every poll, so
    ; toggling it in VESC Tool takes effect on the next one.
    (var pack (ext-boosted-bms))

    (if pack {
      (var num-cells (bufget-u8 pack bms-off-cell-count))

      (set-bms-val 'bms-cell-num num-cells)
      (set-bms-val 'bms-v-tot (/ (bufget-i32 pack bms-off-pack-mv 'little-endian) 1000.0))

      ; The pack reports discharge as positive current, VESC expects the
      ; opposite sign.
      (set-bms-val 'bms-i-in-ic (/ (bufget-i32 pack bms-off-current-ma 'little-endian) -1000.0))

      (set-bms-val 'bms-soc (/ (bufget-u8 pack bms-off-soc) 100.0))
      (set-bms-val 'bms-v-cell-min (/ (bufget-u16 pack bms-off-cell-min 'little-endian) 1000.0))
      (set-bms-val 'bms-v-cell-max (/ (bufget-u16 pack bms-off-cell-max 'little-endian) 1000.0))

      ; 0 mV is a real reading - a shorted or disconnected cell reports it,
      ; and that is what this package is for - so only the explicit "no
      ; reading yet" marker is skipped.
      (looprange i 0 num-cells {
        (var mv (bufget-u16 pack (+ bms-off-cells (* i 2)) 'little-endian))
        (if (!= mv bms-cell-mv-none) (set-bms-val 'bms-v-cell i (/ mv 1000.0)))
      })

      ; set-bms-val only fills this device's local BMS state. Broadcasting it
      ; is what lets the rest of the bus see the pack - which is the normal
      ; case for this package, where a VESC Express bridges the battery to a
      ; separate motor controller.
      (send-bms-can)
    })
  })
)

(defun main () {
  (print "Starting Boosted VESC Driver...")

  (var lib (select-lib))

  (if (eq lib nil)
    (print "Boosted Doctor: no native lib for this hardware (VESC Express needs firmware that reports (sysinfo 'hw-target))")
    {
      (var res (trap (load-native-lib lib)))

      (cond
        ((eq (ix res 0) 'exit-error)
          (print (str-merge "Boosted Doctor: native lib failed to load: " (to-str (ix res 1)))))

        ; load-native-lib reports false when the library's own init did.
        ((not (ix res 1))
          (print "Boosted Doctor: native lib rejected by firmware (version mismatch?)"))

        (t {
          ; Uncomment for a per-frame decode trace in the lisp console.
          ;(ext-boosted-debug 1)

          (spawn bms-loop)
          (print "Driver Started. Waiting for Battery...")
        })
      )
    }
  )
})

(image-save)
(main)

@const-end
