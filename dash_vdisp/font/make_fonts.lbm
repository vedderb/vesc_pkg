(def f-roboto (f-open "Roboto-Bold.ttf" "r"))
(def roboto (load-file f-roboto))
(f-close f-roboto)

(def all-chars (bufcreate 96))
(looprange i 0 96 (bufset-u8 all-chars i (+ i 32)))
(bufset-u8 all-chars 95 0)

(define roboto-bold-16-4c (ttf-prepare roboto 16 'indexed4 all-chars))
(def f (f-open "roboto-bold-16-4c.bin" "w"))
(f-write f roboto-bold-16-4c)
(f-close f)

(define roboto-bold-16-2c (ttf-prepare roboto 16 'indexed2 all-chars))
(def f (f-open "roboto-bold-16-2c.bin" "w"))
(f-write f roboto-bold-16-2c)
(f-close f)

; Page indicator only. "D" must be present in every font used with
; ttf-txt-center: draw-utils measures it as the vertical-centring reference.
(define roboto-bold-12-4c (ttf-prepare roboto 12 'indexed4 "DPage Settings/0123456789"))
(def f (f-open "roboto-bold-12-4c.bin" "w"))
(f-write f roboto-bold-12-4c)
(f-close f)

(define roboto-bold-32-4c (ttf-prepare roboto 32 'indexed4 "D0123456789.+-"))
(def f (f-open "roboto-bold-32-4c.bin" "w"))
(f-write f roboto-bold-32-4c)
(f-close f)

; Gear letters. 36 rather than dash35b's 48, to suit the shorter status strip.
(define roboto-bold-36-4c (ttf-prepare roboto 36 'indexed4 "NPRD12345"))
(def f (f-open "roboto-bold-36-4c.bin" "w"))
(f-write f roboto-bold-36-4c)
(f-close f)

; Speed readout. 64 rather than dash35b's 90, to suit the 240px panel height.
(define roboto-bold-64-2c (ttf-prepare roboto 64 'indexed2 "D0123456789."))
(def f (f-open "roboto-bold-64-2c.bin" "w"))
(f-write f roboto-bold-64-2c)
(f-close f)
