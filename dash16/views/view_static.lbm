@const-start

(defun view-static-state () (list
        indicate-l-on                       ; 0
        indicate-r-on                       ; 1
        highbeam-on                         ; 2
        kickstand-down                      ; 3
        drive-mode                          ; 4
        performance-mode                    ; 5
        cruise-control-active               ; 6
        cruise-control-speed                ; 7
        (round (* 100.0 stats-battery-soc)) ; 8
        battery-a-charging                  ; 9
        stats-fault-code                    ; 10
        (round stats-temp-esc)              ; 11
        (round stats-temp-battery)          ; 12
        (round (secs-since 0))              ; 13
        (cond
            (temp-ambient-rx temp-ambient)
            ((> (get-bms-val 'bms-temp-adc-num) 4) (get-bms-val 'bms-temps-adc 4))
            (t -300.0)
        ) ; 14
        (* (round (* stats-vin 10)) 0.1)    ; 15
        (round (u-speed stats-kmh))         ; 16
        (round stats-amps-now)              ; 17
        cruise-control-active               ; 18
        (round cruise-control-speed)        ; 19
        light-on                            ; 20
        page-now                            ; 21
        (round stats-temp-motor)            ; 22
        battery-a-charging                  ; 23
        battery-a-chg-time                  ; 24
        date-time                           ; 25
))

;(print (ix (view-static-state) 25))

; Never changes with the vehicle state, so it is not in update-state.
; Redrawn on a forced pass because the logo moves when the top strip is
; emptied. Both positions are always drawn, the unused one in the background
; colour, so moving it leaves nothing behind.
; The glass has rounded corners, so the ends of the strip are not usable at
; the very top. The turn signals got away with sitting there because an arrow
; leaves its box corners empty; the logo and the gear glyph do not, so they
; are inset. Nudge these two if anything still clips.
(def strip-inset 16)
(def strip-top 5)

(def speed-y 34)

(defun view-static-frame () {
        (var top (icons-top-hidden))

        ; Wipe everything above the page area so a layout change leaves nothing
        ; behind. All of it is redrawn on this same forced pass.
        (var wipe (img-buffer dm-pool 'indexed2 172 52))
        (img-clear wipe)
        (looprange i 0 3 (disp-render wipe 34 (* i 52) '(0 0)))

        (if top (disp-render img-vesc (+ 34 strip-inset) strip-top colors-vesc))
        (disp-render img-vesc 45 121 (if top colors-hidden colors-vesc))
        (disp-render img-batt-level 36 280 colors-white-aa)
})

(defun view-static-thread () {
        (var update-state (map (fn (x) t) (view-static-state)))
        (var state-last (view-static-state))
        (var frame-todo true)

        (loopwhile t {
                (if frame-todo {
                        (view-static-frame)
                        (setq frame-todo false)
                })

                ; Indicator L
                (var state-ind 0)
                (if (and (ix update-state state-ind) (not (icons-top-hidden))) {
                        (if (icon-on 0)
                            (if (ix state-last state-ind)
                                (disp-render img-indicator-l 35 1 colors-green-icon)
                                (disp-render img-indicator-l 35 1 colors-dim-icon)
                            )
                            (disp-render img-indicator-l 35 1 colors-hidden)
                        )
                })

                ; Warning
                (var state-ind 10)
                (if (and (ix update-state state-ind) (not (icons-top-hidden))) {
                        (if (icon-on 4)
                            (if (!= (ix state-last state-ind) 0)
                                (disp-render img-warning 77 3 colors-red-icon)
                                (disp-render img-warning 77 3 colors-dim-icon)
                            )
                            (disp-render img-warning 77 3 colors-hidden)
                        )
                })

                ; High Beam
                (if (and (or (ix update-state 2) (ix update-state 20)) (not (icons-top-hidden))) {
                        (if (icon-on 1)
                            (if light-on-is-highbeam
                                (if (ix state-last 20)
                                    (disp-render img-highbeam 134 2 colors-blue-icon)
                                    (disp-render img-lowbeam 134 2 colors-green-icon)
                                )
                                (cond
                                    ((ix state-last 2) (disp-render img-highbeam 134 2 colors-blue-icon))
                                    ((ix state-last 20) (disp-render img-lowbeam 134 2 colors-green-icon))
                                    (true (disp-render img-lowbeam 134 2 colors-dim-icon))
                                )
                            )
                            {
                                (disp-render img-highbeam 134 2 colors-hidden)
                                (disp-render img-lowbeam 134 2 colors-hidden)
                            }
                        )
                })

                ; Kick Stand
                ;(var state-ind 3)
                ;(if (ix update-state state-ind) {
                        ;(if (ix state-last state-ind)
                            ;(disp-render img-kickstand 278 14 colors-red-icon)
                            ;(disp-render img-kickstand 278 14 colors-dim-icon)
                        ;)
                ;})

                ; Temperature
                ;(if (or (ix update-state 11) (ix update-state 12) (ix update-state 22)) {
                        ;(cond
                            ;((> (ix state-last 11) config-esc-hot) (disp-render img-temp-e 323 10 colors-red-icon))
                            ;((> (ix state-last 12) config-battery-hot) (disp-render img-temp-b 323 10 colors-red-icon))
                            ;((> (ix state-last 22) config-motor-hot) (disp-render img-temp-m 323 10 colors-red-icon))
                            ;(true                      (disp-render img-temp-b 323 10 colors-dim-icon))
                        ;)
                ;})

                ; Indicator R
                (var state-ind 1)
                (if (and (ix update-state state-ind) (not (icons-top-hidden))) {
                        (if (icon-on 0)
                            (if (ix state-last state-ind)
                                (disp-render img-indicator-r 170 1 colors-green-icon)
                                (disp-render img-indicator-r 170 1 colors-dim-icon)
                            )
                            (disp-render img-indicator-r 170 1 colors-hidden)
                        )
                })

                ; Mode Symbol
                (if (or (ix update-state 4) (ix update-state 5)) {
                        (var txt (cond
                                ((eq (ix state-last 4) 0)   "R")
                                ((eq (ix state-last 4) 1)   "N")
                                ((eq (ix state-last 4) 2)   "1")
                                ((eq (ix state-last 4) 3)   "2")
                                ((eq (ix state-last 4) 4)   "3")
                                (true                       "N")
                        ))

                        (var imgbuf (img-buffer dm-pool 'indexed4 24 27))
                        ;(img-clear imgbuf 2) ; Show where buffer is
                        (img-clear imgbuf)

                        ; Top right when the strip is empty, centre otherwise.
                        ; The vacated slot is painted out on every redraw.
                        (var gx-top (- 206 strip-inset 24))
                        (var gx (if (icons-top-hidden) gx-top 108))
                        (var gy (if (icons-top-hidden) strip-top 2))
                        (ttf-txt-center txt font-32 imgbuf)
                        (disp-render imgbuf gx gy colors-text-aa)
                })

                ; Clock
                ;(if (or (ix update-state 13) (ix update-state 25)) {
                        ;(var imgbuf (img-buffer dm-pool 'indexed4 46 17))
                        ;(img-clear imgbuf)

                        ;(var (hh mm)
                            ;(if (ix state-last 25)
                                ;(list (to-i (ix (ix state-last 25) 4)) (to-i (ix (ix state-last 25) 5)))
                                ;(list (mod (/ (to-i (ix state-last 13)) 3600) 24) (mod (/ (to-i (ix state-last 13)) 60) 60))
                        ;))

                        ;(var str (str-merge (str-from-n hh "%02d:") (str-from-n mm "%02d")))

                        ;(ttf-txt-center str font-16 imgbuf)
                        ;(disp-render imgbuf 425 9 colors-text-aa)
                ;})

                ; Temp
                ;(var state-ind 14)
                ;(if (ix update-state state-ind) {
                        ;(var temp (to-i (ix state-last state-ind)))

                        ;(var imgbuf (img-buffer dm-pool 'indexed4 46 17))
                        ;(img-clear imgbuf)

                        ;(var str (if (> temp -200)
                                ;(str-from-n temp "%d C")
                                ;"---"
                        ;))

                        ;(ttf-txt-center str font-16 imgbuf)
                        ;(disp-render imgbuf 425 26 colors-text-aa)
                ;})

                ; Battery %
                (var state-ind 8)
                (if (ix update-state state-ind) {
                        (var percent (to-i (ix state-last state-ind)))

                        (var (w h) '(14 24))
                        (var imgbuf (img-buffer dm-pool 'indexed2 w h))
                        (var imgbuf2 (img-buffer dm-pool 'indexed2 w h))
                        (img-rectangle imgbuf 0 0 w h 1 '(rounded 2) '(filled))

                        (var bcol (if settings-batt-ramp
                                (cond
                                    ((< percent 15) colors-crit-2)
                                    ((< percent 35) colors-warn-2)
                                    (t colors-ok-2)
                                )
                                colors-theme-2
                        ))

                        (looprange i 0 10 {
                                (disp-render
                                    (if (> percent (* i 10)) imgbuf imgbuf2)
                                    (+ 39 (* i 16)) 283 bcol
                                )
                        })

                        ; Batt %
                        (setq imgbuf (img-buffer dm-pool 'indexed4 61 21))
                        (img-clear imgbuf)
                        (var str (str-from-n percent "%d%%"))
                        (ttf-txt-right str font-24 imgbuf)
                        (disp-render imgbuf 140 257 colors-text-aa)
                })

                ; Battery volts
                (var state-ind 15)
                (if (ix update-state state-ind) {
                        (var v-in (to-float (ix state-last state-ind)))

                        ; Batt V
                        (var imgbuf (img-buffer dm-pool 'indexed4 86 21))
                        (img-clear imgbuf)
                        (var str (str-from-n v-in "%.1fV"))
                        (ttf-txt-left str font-24 imgbuf)
                        (disp-render imgbuf 38 257 colors-text-aa)
                })

                ; Speed or Charging
                (if (or (ix update-state 16) (ix update-state 17)
                        (ix update-state 23) (ix update-state 24)) {

                        (var kmh (to-float (ix state-last 16)))
                        (var current (to-float (ix state-last 17)))
                        (var charging (ix state-last 23))
                        (var min-left (to-i (ix state-last 24)))

                        (var imgbuf (img-buffer dm-pool 'indexed4 172 84))
                        (img-clear imgbuf)

                        ; TODO: Separate case for charging
                        ; with AA for the text
                        (if charging
                            {
                                (img-blit imgbuf img-charging 6 0 0)
                                (ttf-txt-center
                                    (str-merge "Time Left " (str-from-n (/ min-left 60) "%dh ") (str-from-n (mod min-left 60) "%dmin"))
                                    font-16-2c imgbuf '(0 3) 80
                                )
                            }
                            {
                                ;(ttf-text imgbuf 125 81 '(0 3) font-16-2c "km/h")
                                (ttf-txt-center (u-speed-str) font-16-2c imgbuf '(0 3) 81)
                                (ttf-txt-center (str-from-n kmh) font-90 imgbuf '(0 3) 65)
                            }
                        )

                        (disp-render imgbuf 34 speed-y
                            (if charging colors-charging colors-speed))
                })

                ; Cruise Control
                (if (or (ix update-state 18) (ix update-state 19)) {
                        (var active (ix state-last 18))
                        (var kmh (u-speed (to-float (ix state-last 19))))

                        (var (color-txt color-icon) (if active
                                (list colors-text-aa colors-green-icon)
                                (list colors-dim-icon colors-dim-icon)
                        ))

                        (if (icon-on 5)
                            (disp-render img-cruise 94 118 color-icon)
                            (disp-render img-cruise 94 118 colors-hidden)
                        )

                        ; The speed goes with the icon, so hiding one hides both
                        (var imgbuf (img-buffer dm-pool 'indexed4 52 28))
                        (img-clear imgbuf)
                        (if (icon-on 5)
                            (ttf-txt-left (str-from-n kmh "%.0f") font-32 imgbuf))
                        (disp-render imgbuf 139 125
                            (if (icon-on 5) color-txt colors-hidden))
                })

                ; Page
                ;(var state-ind 21)
                ;(if (ix update-state state-ind) {
                        ;(var page (to-i (ix state-last state-ind)))

                        ;(var imgbuf (img-buffer dm-pool 'indexed4 74 20))
                        ;(img-clear imgbuf)
                        ;(var str (str-merge (str-from-n (+ page 1) "Page %d/") (str-from-n page-num)))
                        ;(ttf-txt-center str font-16 imgbuf)
                        ;(disp-render imgbuf 393 297 colors-text-aa)
                ;})

                (var force view-force-static)
                (setq view-force-static false)
                (if force (setq frame-todo true))

                (var state-new (view-static-state))
                (looprange i 0 (length update-state)
                    (setix update-state i (or force (not-eq (ix state-last i) (ix state-new i))))
                )
                (setq state-last state-new)

                (sleep 0.05)
        })
})
